{
  "name": "diffy",
  "version": "0.1.0",
  "description": "Terminal git diff reviewer with file list and context expansion",
  "type": "module",
  "bin": {
    "diffy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "15.0.0",
    "gitdiff-parser": "0.3.1",
    "ink": "7.1.1",
    "lowlight": "3.3.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
