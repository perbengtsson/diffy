{
  "name": "diffy",
  "version": "0.1.0",
  "description": "Terminal git diff reviewer with file list and context expansion",
  "type": "module",
  "bin": {
    "diffy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "gitdiff-parser": "^0.3.1",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
